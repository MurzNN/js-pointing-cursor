{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "vue-pointing-cursor",
  "title": "Vue Pointing Cursor",
  "author": "Alexey Murz Korepov",
  "description": "An oversized Vue 3 cursor with curved motion, follow mode, replaceable SVG shapes, and click animation.",
  "dependencies": [
    "vue@^3.5.0",
    "js-pointing-cursor"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "packages/vue/src/pointing-cursor/VuePointingCursor.vue",
      "content": "<script setup lang=\"ts\">\nimport {\n  computed,\n  onBeforeUnmount,\n  onMounted,\n  ref,\n  watch,\n  type CSSProperties,\n} from 'vue'\nimport {\n  createCursorController,\n  type ClickOptions,\n  type MotionStyle,\n  type MouseButton,\n  type MoveToOptions,\n  type Point,\n  type ShapeName,\n} from 'js-pointing-cursor'\n\ndefineOptions({ name: 'VuePointingCursor', inheritAttrs: false })\n\nconst props = withDefaults(\n  defineProps<{\n    size?: string\n    shape?: ShapeName\n    stroke?: string\n    fill?: string\n    strokeWidth?: number | string\n    visible?: boolean\n    followMouse?: boolean\n    hideNativeCursor?: boolean\n    x?: number\n    y?: number\n    hotspotX?: number\n    hotspotY?: number\n    zIndex?: number\n    minDuration?: number\n    maxDuration?: number\n    motionStyle?: MotionStyle\n    defaultAngle?: number\n    mirrorNativeClicks?: boolean\n    clickAnimationDuration?: number\n    clickBurst?: boolean\n    clickBurstStrokeWidth?: number | string\n    clickBurstSize?: string\n    clickBurstDurationMs?: number\n    clickBurstLeftColor?: string\n    clickBurstRightColor?: string\n    clickBurstColor?: string\n    emitMoveFrames?: boolean\n  }>(),\n  {\n    size: '3em',\n    shape: 'arrow',\n    stroke: '#111111',\n    fill: '#ffffff',\n    strokeWidth: 2,\n    visible: true,\n    followMouse: false,\n    hideNativeCursor: false,\n    hotspotX: undefined,\n    hotspotY: undefined,\n    zIndex: 9999,\n    minDuration: 280,\n    maxDuration: 900,\n    motionStyle: 'dangling',\n    defaultAngle: undefined,\n    mirrorNativeClicks: true,\n    clickAnimationDuration: 120,\n    clickBurst: true,\n    clickBurstStrokeWidth: 2,\n    clickBurstSize: '2.25em',\n    clickBurstDurationMs: 420,\n    clickBurstLeftColor: '#22c55e',\n    clickBurstRightColor: '#ef4444',\n    clickBurstColor: '#111111',\n    emitMoveFrames: false,\n  },\n)\n\nconst emit = defineEmits<{\n  move: [point: Point]\n  show: []\n  hide: []\n}>()\n\nconst rootEl = ref<HTMLElement | null>(null)\nconst innerEl = ref<HTMLElement | null>(null)\nconst isVisible = ref(props.visible)\nconst pressed = ref(false)\nconst button = ref<MouseButton | null>(null)\nconst shapeMarkup = ref('')\nconst shapePaintStyle = ref<Record<string, string>>({})\n\nfunction configFromProps() {\n  return {\n    size: props.size,\n    shape: props.shape,\n    stroke: props.stroke,\n    fill: props.fill,\n    strokeWidth: props.strokeWidth,\n    visible: props.visible,\n    followMouse: props.followMouse,\n    hideNativeCursor: props.hideNativeCursor,\n    x: props.x,\n    y: props.y,\n    hotspotX: props.hotspotX,\n    hotspotY: props.hotspotY,\n    zIndex: props.zIndex,\n    minDuration: props.minDuration,\n    maxDuration: props.maxDuration,\n    motionStyle: props.motionStyle,\n    defaultAngle: props.defaultAngle,\n    mirrorNativeClicks: props.mirrorNativeClicks,\n    clickAnimationDuration: props.clickAnimationDuration,\n    clickBurst: props.clickBurst,\n    clickBurstStrokeWidth: props.clickBurstStrokeWidth,\n    clickBurstSize: props.clickBurstSize,\n    clickBurstDurationMs: props.clickBurstDurationMs,\n    clickBurstLeftColor: props.clickBurstLeftColor,\n    clickBurstRightColor: props.clickBurstRightColor,\n    clickBurstColor: props.clickBurstColor,\n    emitMoveFrames: props.emitMoveFrames,\n  }\n}\n\nconst controller = createCursorController(\n  {\n    getRootEl: () => rootEl.value,\n    getInnerEl: () => innerEl.value,\n    onMove: (point) => emit('move', point),\n    onShow: () => emit('show'),\n    onHide: () => emit('hide'),\n    onVisibilityChange: (v) => {\n      isVisible.value = v\n    },\n    onInteractionChange: (snap) => {\n      pressed.value = snap.pressed\n      button.value = snap.button\n    },\n  },\n  configFromProps(),\n)\n\nfunction syncShapeUi() {\n  shapeMarkup.value = controller.getShapeMarkup()\n  shapePaintStyle.value = controller.getShapePaintStyle()\n}\nsyncShapeUi()\n\nconst outerStyle = computed((): CSSProperties => ({\n  position: 'fixed',\n  left: '0',\n  top: '0',\n  width: props.size,\n  height: props.size,\n  zIndex: props.zIndex,\n  pointerEvents: 'none',\n}))\n\nonMounted(() => {\n  controller.mount()\n  syncShapeUi()\n})\n\nonBeforeUnmount(() => {\n  controller.destroy()\n})\n\nwatch(\n  () => configFromProps(),\n  (next) => {\n    controller.setOptions(next)\n    syncShapeUi()\n  },\n  { deep: true },\n)\n\ndefineExpose({\n  show: () => controller.show(),\n  hide: () => controller.hide(),\n  moveTo: (\n    target: number | string | Element,\n    yOrOptions?: number | MoveToOptions,\n    maybeOptions?: MoveToOptions,\n  ) => controller.moveTo(target, yOrOptions, maybeOptions),\n  setFollow: (enabled: boolean) => controller.setFollow(enabled),\n  getPosition: (): Point => controller.getPosition(),\n  click: (options?: ClickOptions) => controller.click(options),\n  clickAt: (\n    target: number | string | Element,\n    yOrOptions?: number | ClickOptions,\n    maybeOptions?: ClickOptions,\n  ) => controller.clickAt(target, yOrOptions, maybeOptions),\n  leftClick: (options?: Omit<ClickOptions, 'button'>) =>\n    controller.leftClick(options),\n  rightClick: (options?: Omit<ClickOptions, 'button'>) =>\n    controller.rightClick(options),\n  setMotionStyle: (style: MotionStyle) => controller.setMotionStyle(style),\n})\n</script>\n\n<template>\n  <div\n    ref=\"rootEl\"\n    class=\"pointing-cursor\"\n    v-bind=\"$attrs\"\n    :class=\"[\n      `pointing-cursor--${shape}`,\n      { 'pointing-cursor--hidden': !isVisible },\n    ]\"\n    :style=\"outerStyle\"\n    aria-hidden=\"true\"\n  >\n    <div ref=\"innerEl\" class=\"pointing-cursor__inner\">\n      <slot\n        :pressed=\"pressed\"\n        :button=\"button\"\n        :stroke=\"stroke\"\n        :fill=\"fill\"\n        :stroke-width=\"strokeWidth\"\n      >\n        <div\n          class=\"pointing-cursor__shape\"\n          :data-pressed=\"pressed ? 'true' : 'false'\"\n          :data-button=\"button ?? undefined\"\n          :style=\"shapePaintStyle\"\n          v-html=\"shapeMarkup\"\n        />\n      </slot>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n.pointing-cursor {\n  will-change: transform;\n  contain: layout style;\n}\n\n.pointing-cursor__inner {\n  display: block;\n  width: 100%;\n  height: 100%;\n}\n\n.pointing-cursor__shape {\n  display: block;\n  width: 100%;\n  height: 100%;\n}\n\n.pointing-cursor__shape :deep(.pointing-cursor-shape) {\n  display: block;\n  width: 100%;\n  height: 100%;\n  overflow: visible;\n}\n\n.pointing-cursor--hidden {\n  opacity: 0;\n  visibility: hidden;\n  transition:\n    opacity 120ms ease,\n    visibility 120ms ease;\n}\n\n.pointing-cursor:not(.pointing-cursor--hidden) {\n  opacity: 1;\n  visibility: visible;\n  transition:\n    opacity 120ms ease,\n    visibility 120ms ease;\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "packages/vue/src/pointing-cursor/index.ts",
      "content": "import type { App, Plugin } from 'vue'\nimport VuePointingCursor from './VuePointingCursor.vue'\n\nexport type {\n  ShapeName,\n  MotionStyle,\n  MouseButton,\n  CursorInteractionState,\n  Point,\n  MotionFrame,\n  MoveToOptions,\n  ClickOptions,\n  MoveTarget,\n  CursorController,\n  CursorControllerConfig,\n} from 'js-pointing-cursor'\n\nexport {\n  SHAPE_SVGS,\n  SHAPE_STROKE_SCALE,\n  SHAPE_HOTSPOTS,\n  SHAPE_DEFAULT_ANGLES,\n  createCursorController,\n  createCurvedPath,\n  animateAlong,\n  jumpTo,\n  durationForDistance,\n  samplePath,\n  resolveElementCenter,\n  resolveMoveTarget,\n  TargetResolutionError,\n  mountClickBurst,\n  createMotionStyle,\n  createCursorInteraction,\n  dispatchRealClick,\n  headingToRotation,\n} from 'js-pointing-cursor'\n\nexport { VuePointingCursor }\nexport { VuePointingCursor as default }\n\nexport interface VuePointingCursorPluginOptions {\n  name?: string\n}\n\nexport const VuePointingCursorPlugin: Plugin = {\n  install(app: App, options: VuePointingCursorPluginOptions = {}) {\n    app.component(options.name ?? 'VuePointingCursor', VuePointingCursor)\n  },\n}\n",
      "type": "registry:ui"
    }
  ],
  "docs": "Installs into components/ui/pointing-cursor (plus the js-pointing-cursor npm dependency). Import from @/components/ui/pointing-cursor. Demo: https://murznn.github.io/js-pointing-cursor/vue/",
