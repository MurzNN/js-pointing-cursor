{
  "name": "react-pointing-cursor",
  "version": "0.3.1",
  "description": "React oversized pointing cursor with curved motion, follow mode, and click burst.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/react-pointing-cursor.cjs",
  "module": "./dist/react-pointing-cursor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-pointing-cursor.js",
      "require": "./dist/react-pointing-cursor.cjs"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.2",
    "unplugin-dts": "^1.0.0-beta.6",
    "vite": "^7.1.7",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "homepage": "https://murznn.github.io/js-pointing-cursor/",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MurzNN/js-pointing-cursor.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "cursor",
    "pointer",
    "animation",
    "svg",
    "shadcn"
  ]
}
